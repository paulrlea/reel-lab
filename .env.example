# Keep this file private after copying it to .env.
DATA_DIR=data
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_URL=http://127.0.0.1:11434
DRY_RUN=true
ALLOW_LIVE_TRIALS=false
MAX_PER_DAY=2
MIN_INTERVAL_HOURS=6
IG_LOGIN=facebook
IG_API_VERSION=v27.0
IG_USER_ID=
IG_ACCESS_TOKEN=
# Local upload for Facebook Login for Business; URL upload for Instagram Login.
IG_UPLOAD=resumable
# Optional, for URL mode only. HTTPS directory containing exact rendered files.
MEDIA_BASE_URL=
